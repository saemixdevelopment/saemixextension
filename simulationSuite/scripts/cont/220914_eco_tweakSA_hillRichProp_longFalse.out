Nonlinear mixed-effects model
  Model function:  PD Hill model
  Model type:  structural
function (psi, id, xidep) 
{
    dose <- xidep[, 1]
    e0 <- psi[id, 1]
    emax <- psi[id, 2]
    e50 <- psi[id, 3]
    gamma <- psi[id, 4]
    f <- e0 + emax * dose^gamma/(e50^gamma + dose^gamma)
    return(f)
}
