function (psi, id, xidep) 
{
    dose <- xidep[, 1]
    e0 <- psi[id, 1]
    imax <- psi[id, 2]
    ed50 <- psi[id, 3]
    gamma <- psi[id, 4]
    f <- e0 * (1 - imax * (dose^gamma)/((ed50^gamma) + (dose^gamma)))
    return(f)
}
