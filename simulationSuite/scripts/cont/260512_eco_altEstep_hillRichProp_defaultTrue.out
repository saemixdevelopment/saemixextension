+     headersSE[-c(1)]<-paste("SE.", headersSE[-c(1)],sep="")
+     headersOrig <- c(headersOrig, headersSE[-c(1)])
+     write(headersOrig,namRes,ncol=length(headersOrig))
+   }
+   write(c(l1,l2),namRes,ncol=length((headersOrig)),append=T)
+ }
