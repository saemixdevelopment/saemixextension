+   saemix.data<-saemixData(file.path(datDir,namfich),header=T,name.group="id",name.predictors="dose",name.response="y",units=list(x="-",y="-"))
+   
+   yfit <- saemix(saemix.model, saemix.data, saemix.options)
+   if(computeIndPar)
