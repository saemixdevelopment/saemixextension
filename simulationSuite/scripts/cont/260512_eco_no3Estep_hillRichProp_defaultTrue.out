> pvrai <- c(parpop, diag(omega)[1:2], omega[2,3],omega[3,3], respar)
> #pvrai<-c(5,30,500,0.09,0.490,0.245,0.490,sqrt(0.01))
> pfaux<-c(10,60,1000,0.1,0.1,0.01,0.1,sqrt(0.0625))
> 
> if(settings=="defaultTrue") {
+   psi0 <- pvrai
+   omega0 <- diag(c(1,1,1,0.2))
