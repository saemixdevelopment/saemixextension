3   1  400  66.59807     0   0    0   1     1
4   1  500  72.80844     0   0    0   1     1
5   1  700  50.88093     0   0    0   1     1
6   1 1000  40.74835     0   0    0   1     1
7   2    0 107.02172     0   0    0   1     1
8   2  200  94.73490     0   0    0   1     1
9   2  400  61.56531     0   0    0   1     1
10  2  500  46.95123     0   0    0   1     1
-----------------------------------
----          Model            ----
-----------------------------------
Nonlinear mixed-effects model
  Model function:  PD Imax model
  Model type:  structural
function (psi, id, xidep) 
{
    dose <- xidep[, 1]
    e0 <- psi[id, 1]
    imax <- psi[id, 2]
    ed50 <- psi[id, 3]
    gamma <- psi[id, 4]
    f <- e0 * (1 - imax * (dose^gamma)/((ed50^gamma) + (dose^gamma)))
    return(f)
}
