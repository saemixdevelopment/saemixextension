4   1  500 55.96485     0   0    0   1     1
5   1  700 45.77221     0   0    0   1     1
6   1 1000 41.70708     0   0    0   1     1
7   2    0 96.48302     0   0    0   1     1
8   2  200 86.47464     0   0    0   1     1
9   2  400 76.69999     0   0    0   1     1
10  2  500 67.97767     0   0    0   1     1
-----------------------------------
----          Model            ----
-----------------------------------
Nonlinear mixed-effects model
  Model function:  PD Imax model
  Model type:  structural
function (psi, id, xidep) 
{
    dose <- xidep[, 1]
    e0 <- psi[id, 1]
    imax <- psi[id, 2]
    ed50 <- psi[id, 3]
    gamma <- psi[id, 4]
    f <- e0 * (1 - imax * (dose^gamma)/((ed50^gamma) + (dose^gamma)))
    return(f)
}
