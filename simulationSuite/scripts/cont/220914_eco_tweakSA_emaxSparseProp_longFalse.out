Nonlinear mixed-effects model
  Model function:  PD Emax model
  Model type:  structural
function (psi, id, xidep) 
{
    dose <- xidep[, 1]
    e0 <- psi[id, 1]
    emax <- psi[id, 2]
    e50 <- psi[id, 3]
    f <- e0 + emax * dose/(e50 + dose)
    return(f)
}
