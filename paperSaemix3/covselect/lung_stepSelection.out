function (psi, id, xidep) 
{
    T <- xidep[, 1]
    y <- xidep[, 2]
    cens <- which(xidep[, 3] == 1)
    init <- which(T == 0)
    Te <- psi[id, 1]
    gamma <- psi[id, 2]
    Nj <- length(T)
    ind <- setdiff(1:Nj, append(init, cens))
    hazard <- (gamma/Te) * (T/Te)^(gamma - 1)
